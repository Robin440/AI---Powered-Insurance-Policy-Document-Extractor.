# Use your existing .env; do not commit secrets.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional overrides:
# groq defaults: LLM_MODEL=openai/gpt-oss-120b, JUDGE_MODEL=openai/gpt-oss-20b
# ollama defaults: LLM_MODEL=qwen2.5:3b, JUDGE_MODEL=qwen2.5:3b
# LLM_MODEL=
# JUDGE_MODEL=

# Optional Ollama URL (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
